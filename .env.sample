# Renómbrame a .env y rellena tus claves. ¡No subas .env a GitHub!
# (.env ya está en .gitignore; si alguna vez se expone, rota las keys en
# https://app.alpaca.markets/paper/dashboard/overview)
APCA_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets/v2
APCA_API_KEY_ID=tu_key
APCA_API_SECRET_KEY=tu_secret
LOG_LEVEL=INFO

# Los parámetros de riesgo (riesgo por trade, RR mínimo, ATR de stop/trailing,
# límites de pérdida diaria, apalancamiento, etc.) ya NO se leen de aquí:
# se ajustan por línea de comandos al lanzar run_paper.py. Corre
#   python -m src.run_paper --help
# para ver todos los flags (--risk-per-trade, --min-rr, --atr-sl-mult, ...).
